{
  "name": "@newspoint/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./node": "./src/node.ts",
    "./orm": "./src/orm.ts",
    "./polls": "./src/polls.ts",
    "./poll-types": "./src/poll-types.ts",
    "./podcasts": "./src/podcasts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:verify": "tsx src/scripts/db-verify.ts"
  },
  "dependencies": {
    "dotenv": "18.0.3",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
