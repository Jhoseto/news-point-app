{
  "name": "newspoint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:check": "pnpm --filter @newspoint/db db:check",
    "db:verify": "pnpm --filter @newspoint/db db:verify",
    "import:wp": "pnpm --filter @newspoint/wp-import run wp:import"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
