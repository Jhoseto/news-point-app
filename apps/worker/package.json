{
  "name": "@newspoint/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --import tsx src/index.ts",
    "start": "node --use-system-ca --import tsx src/index.ts",
    "sync:once": "node --use-system-ca --import tsx src/index.ts --once",
    "city:collect:watch": "node --use-system-ca --import tsx src/city-pilot/cli.ts --watch",
    "city:readiness": "node --use-system-ca --import tsx src/city-pilot/readiness.ts",
    "city:pilot:once": "node --use-system-ca --import tsx src/city-pilot/cli.ts",
    "city:pilot:watch": "node --use-system-ca --import tsx src/city-pilot/cli.ts --watch",
    "city:pilot:audit": "node --use-system-ca --import tsx src/city-pilot/audit.ts",
    "city:pilot:report": "node --import tsx src/city-pilot/report.ts",
    "live:simulate": "node --import tsx src/simulate.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@newspoint/content": "workspace:*",
    "@newspoint/db": "workspace:*",
    "@newspoint/wp-import": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
