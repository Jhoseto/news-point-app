# Copy to .env.local and fill in values. Never commit real values.

# Supabase DEV project (required). Supabase -> Connect -> Connection String -> URI.
# Transaction pooler, port 6543, used by the apps with prepare: false:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Session pooler, port 5432, used for migrations and LISTEN/NOTIFY:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SESSION=

# Supabase TEST project (required for automated tests; separate project).
TEST_DATABASE_URL=
TEST_DATABASE_URL_SESSION=

# Supabase API (optional; not used at this stage).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Source of real content (public WordPress REST API).
WP_SOURCE_URL=https://newspoint.bg
# Import preset for the homepage demo: latest N plus per-category N.
IMPORT_LATEST_COUNT=40
IMPORT_PER_CATEGORY_COUNT=8
# Seconds between sync runs of new articles from the old site.
SYNC_INTERVAL_SECONDS=120

# Protects the web revalidate endpoint used by the live dispatcher (T7).
REVALIDATE_SECRET=
# Signs Studio sessions (Better Auth, DEC-110); at least 32 random characters.
STUDIO_SESSION_SECRET=
# Only for automated checks of `pnpm studio:user`; leave empty and type the password.
STUDIO_USER_PASSWORD=

# Local app URLs.
WEB_URL=http://localhost:3000
# Where the Studio server listens; the web app proxies /admin to it.
STUDIO_URL=http://localhost:3001
# Address editors open (Studio through the public host).
STUDIO_PUBLIC_URL=http://localhost:3000/admin

# LivePoint — weather API User-Agent (required by provider ToS). Optional override.
MET_NORWAY_USER_AGENT=
# LivePoint — traffic (TomTom). Portal: Map Display + Traffic Incidents + Traffic Flow.
# Leave empty locally: the UI stays "still connecting" and the server makes no TomTom calls.
TOMTOM_API_KEY=
# Public, read-only Cesium ion token with access to OSM Buildings (asset 96188).
# Used only for the optional 3D traffic view. Restrict it to the site origin in ion.
CESIUM_ION_TOKEN=
# TomTom key security (developer portal):
# - Local dev: Domain whitelisting OFF (TomTom does not accept "localhost" in the list).
# - Production: turn Domain whitelisting ON and add newspoint.bg and www.newspoint.bg
#   (or *.newspoint.bg). Use a separate production key if you prefer; same env var name.
