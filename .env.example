# Copy to .env.local and fill in values. Never commit real values.

# Supabase DEV project (required). Supabase -> Connect -> Connection String -> URI.
# Transaction pooler, port 6543, used by the apps with prepare: false:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Session pooler, port 5432, used for migrations and LISTEN/NOTIFY:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SESSION=

# Supabase TEST project (required for automated tests; separate project).
TEST_DATABASE_URL=
TEST_DATABASE_URL_SESSION=

# Supabase API (optional; not used at this stage).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Source of real content (public WordPress REST API).
WP_SOURCE_URL=https://newspoint.bg
# Import preset for the homepage demo: latest N plus per-category N.
IMPORT_LATEST_COUNT=40
IMPORT_PER_CATEGORY_COUNT=8
# Seconds between sync runs of new articles from the old site.
SYNC_INTERVAL_SECONDS=120

# Shared secret between worker and web for the revalidate endpoint.
REVALIDATE_SECRET=
# Secret for Studio session signing.
STUDIO_SESSION_SECRET=

# Local app URLs.
WEB_URL=http://localhost:3000
STUDIO_URL=http://localhost:3001
