# Copy to .env.local and fill in values. Never commit real values.

# Day-to-day local development uses the server database through an SSH tunnel
# (DEC-139). Run dev-server-tunnel.bat or restart.bat first. Postgres on the
# server stays on 127.0.0.1; do not open port 5432. Example:
#   DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/np2_newspoint2
#   DATABASE_URL_SESSION=postgresql://USER:PASSWORD@127.0.0.1:5433/np2_newspoint2
# DEV_REMOTE=1
# MEDIA_ROOT=/home/np2/storage
# MEDIA_ORIGIN=https://newspoint.bg
# MEDIA_SSH_TARGET=np2@95.217.114.220
# MEDIA_SSH_PORT=6543
# MEDIA_SSH_KEY=C:/Users/YOU/.ssh/np2_newspoint

# Supabase DEV project (optional leftover). Supabase -> Connect -> Connection String -> URI.
# Transaction pooler, port 6543, used by the apps with prepare: false:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Session pooler, port 5432, used for migrations and LISTEN/NOTIFY:
#   postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SESSION=

# Supabase TEST project (required for automated tests; separate project).
TEST_DATABASE_URL=
TEST_DATABASE_URL_SESSION=

# Supabase API (required for private LivePoint photos; apply migration 11).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Server-only secret/service role key; never expose it in NEXT_PUBLIC_ variables.
# Private bucket: livepoint-submissions (validated images re-encoded to WebP).

# Google AI Studio key. Used for article listening (Gemini Flash-Lite TTS) and later Google AI work.
GOOGLE_AI_STUDIO=
# Private TTS cache outside the deployed checkout (never under public/media).
# Production default: ~/.cache/newspoint/tts; local default: apps/web/.tts-cache.
# Existing WAV sources are retained; Opus/AAC delivery files are encoded once.
TTS_CACHE_DIR=
WP_SOURCE_URL=https://newspoint.bg
# Import preset for the homepage demo: latest N plus per-category N.
IMPORT_LATEST_COUNT=40
IMPORT_PER_CATEGORY_COUNT=8
# Seconds between sync runs of new articles from the old site.
SYNC_INTERVAL_SECONDS=120
# Server-only city collection and isolated source checks. Collection does not publish records.
CITY_PILOT_USER_AGENT=
CITY_PILOT_OUTPUT_DIR=
CITY_PILOT_STORE_PREVIEW=
# Set to 1 for the isolated collector, to journal checks and versions in Postgres.
CITY_PILOT_PERSIST_DB=
# Optional local development preview backed by hidden pilot records; never enables public routes.
CITY_GUIDE_USE_DB_PREVIEW=

# City module: leave disabled until the separate production release. No navigation button is added.
CITY_GUIDE_ENABLED=
# Absolute private collector/web storage directory OUTSIDE MEDIA_ROOT/public.
# Required for production photos, attached files and protected collector health.
CITY_GUIDE_STORAGE_DIR=

# Protects the web revalidate endpoint used by the live dispatcher (T7).
REVALIDATE_SECRET=
# Optional server-only Web origin for same-server cache updates (e.g. http://127.0.0.1:3100).
# Leave blank locally to use WEB_URL. Does not change public/canonical URLs.
REVALIDATE_INTERNAL_URL=
# Signs Studio sessions (Better Auth, DEC-110); at least 32 random characters.
STUDIO_SESSION_SECRET=
# AI Studio uses GOOGLE_AI_STUDIO above; set this only to use a separate server-only key.
GEMINI_API_KEY=
# Optional FFmpeg paths; leave blank when ffmpeg/ffprobe are on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Private resumable-upload staging. Optional absolute directory OUTSIDE MEDIA_ROOT/public.
# Default: .newspoint-upload-temp beside MEDIA_ROOT; shared by Studio and the worker.
MEDIA_UPLOAD_TEMP_ROOT=
# Dedicated upload-worker mode. For QA, use only an isolated DB and private storage.
# Skips WordPress sync, scheduled publishing, push and AI; queued upload intents still run.
# Example: set NP_UPLOAD_WORKER_ONLY=1, then pnpm --filter @newspoint/worker exec node --use-system-ca --import tsx src/index.ts --once
NP_UPLOAD_WORKER_ONLY=0
# Facebook Page publishing. Keep disabled until migration 39 and provider setup are complete.
SOCIAL_PUBLISHING_ENABLED=0
# Active server-side publisher. Production uses the protected Make webhook.
# `meta` remains available only as the legacy rollback provider.
SOCIAL_PUBLISHING_PROVIDER=make
# Make mode only. Keep the webhook URL and API key server-side; never use NEXT_PUBLIC_ names.
MAKE_SOCIAL_WEBHOOK_URL=
MAKE_SOCIAL_WEBHOOK_API_KEY=
MAKE_FACEBOOK_PAGE_ID=
MAKE_FACEBOOK_PAGE_NAME=

# Legacy direct Meta provider only. Both public URLs must use the same approved HTTPS host.
# Register /admin/api/social/callback/ when intentionally switching back to `meta`.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# Optional Facebook Login for Business user-token configuration ID.
META_LOGIN_CONFIG_ID=
# Base64-encoded 32 random bytes. Keep stable and back it up separately from the DB.
# Approved exception: only encrypted Page tokens live in Postgres; this key stays here.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Optional absolute private persistent directory outside checkout and MEDIA_ROOT.
# Default: .newspoint-social beside MEDIA_ROOT.
SOCIAL_PUBLISHING_TEMP_ROOT=
# Only for automated checks of `pnpm studio:user`; leave empty and type the password.
STUDIO_USER_PASSWORD=

# Local app URLs.
WEB_URL=http://localhost:3000
# Explicit launch opt-in, server only. Default 0 keeps HTTP headers and HTML meta noindex.
# Set to 1 only for a production build with the real HTTPS WEB_URL, then rebuild/restart.
# Local/IP and known tunnel/hosting-preview origins remain noindex even if accidentally set to 1.
NP_PUBLIC_INDEXING=0
# Optional: load GA4/GTM on preview/tunnel when indexing is still 0 (Realtime tests only).
NP_PUBLIC_ANALYTICS=0
# Reuse the same GA4 property as WordPress (public IDs — set one, not both).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Production NewsPoint.bg GA4 (property 422487136):
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z39FGHRFPP
# Clicky site id from Preferences → Tracking code (public in the page script). Empty disables Clicky.
# NEXT_PUBLIC_CLICKY_SITE_ID=
# Public reader origin, also trusted by reader forms behind the reverse proxy.
# On the server use the actual HTTPS site origin, not the internal listening port.
# Optional read-only SEO audit target; defaults to http://localhost:3000.
# Keep WEB_URL as the canonical origin for the app being audited.
SEO_BASE_URL=http://localhost:3000
# Polls: optional separate >=32-character key; defaults to the existing Studio secret.
# Keep stable: rotating it invalidates anonymous voter identities and IP limits.
POLL_SIGNING_SECRET=
# Production only: single-IP header OVERWRITTEN by your trusted ingress.
# Block direct access to the origin. Unset = voting fails closed outside localhost dev.
# np2 server: x-real-ip (Apache sets it in public_html/.htaccess via start-newspoint.sh).
POLL_TRUSTED_IP_HEADER=
# Where the Studio server listens; the web app proxies /admin to it.
STUDIO_URL=http://localhost:3001
# Public URL where editors open Studio (path must include /admin).
# Local: web proxy at :3000. Production: https://newspoint.bg/admin (or https://www.newspoint.bg/admin).
STUDIO_PUBLIC_URL=http://localhost:3000/admin
# Set to 1 in `dev` to skip the same-origin check on the Studio port; do not set in PRODUCTION.
STUDIO_DEV_DIRECT=
# Comma-separated extra origins allowed for Better Auth, e.g. https://preview.example.com.
# Use this to grant access to a Cloudflare quick-tunnel host without re-opening the global wildcard.
STUDIO_EXTRA_TRUSTED_ORIGINS=
# Set to 1 to allow *.trycloudflare.com in the Studio trusted-origin list. Off by default.
# Used by scripts/start-public-demo.ps1. Never set it on a shared/production deployment.
NP_ALLOW_CF_TUNNEL=
# Read-only source address override for the WP importer (browser-like source IP). Empty = auto.
WP_SOURCE_ADDRESS=
# Published URL exposed to the browser as `NEXT_PUBLIC_STUDIO_PUBLIC_URL`. Mirrors STUDIO_PUBLIC_URL.
# Empty = the server-side value is used. Set this only when the browser cannot see the server value
# (e.g. behind a reverse proxy that rewrites the host header).
NEXT_PUBLIC_STUDIO_PUBLIC_URL=
# Password reset emails (Resend). Missing provider configuration never logs a reset token by default.
RESEND_API_KEY=
STUDIO_EMAIL_FROM=NewsPoint Studio <noreply@newspoint.bg>
# Local development only: explicitly set to 1 to log reset links when mail is not wired yet.
# Production never logs reset links, even if this is set accidentally.
STUDIO_PASSWORD_RESET_LOG=

# LivePoint — weather API User-Agent (required by provider ToS). Optional override.
MET_NORWAY_USER_AGENT=
# LivePoint — traffic (TomTom). Portal: Map Display + Traffic Incidents + Traffic Flow.
# Leave empty locally: the UI stays "still connecting" and the server makes no TomTom calls.
TOMTOM_API_KEY=
# Public, read-only Cesium ion token with access to OSM Buildings (asset 96188).
# Used only for the optional 3D traffic view. Restrict it to the site origin in ion.
CESIUM_ION_TOKEN=
# TomTom key security (developer portal):
# - Local dev: Domain whitelisting OFF (TomTom does not accept "localhost" in the list).
# - Production: turn Domain whitelisting ON and add newspoint.bg and www.newspoint.bg
#   (or *.newspoint.bg). Use a separate production key if you prefer; same env var name.

# Load tests (tests/load/*).
LOAD_BASE_URL=
LOAD_USERS=
LOAD_WINDOW_MS=
LOAD_WARMUP=

# Web Push (reader PWA). Generate locally with `node scripts/generate-vapid-keys.mjs`.
# On iOS Web Push requires the page to be added to the Home Screen and iOS 16.4+.
VAPID_SUBJECT=mailto:push@newspoint.bg
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set 1 only behind a trusted reverse proxy that replaces X-Forwarded-For.
# Direct origin access must then be blocked; otherwise use the global limiter.
PUSH_TRUST_PROXY=0

# Local editor QA only. Requires migration 30; registered QA IDs never enqueue reader push.
# Use a separate Studio process, with [QA editor] titles and qa-editor-<run>-... slugs.
EDITOR_QA_RUN_ID=

# Optional private, persistent directory for Studio audit recovery (never under MEDIA_ROOT).
# Default: ~/studio-audit. On production use a location outside the deployed checkout.
STUDIO_AUDIT_BUFFER_DIR=
