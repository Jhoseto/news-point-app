{
  "name": "newspoint-article-cache",
  "main": "article-cache-worker.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "newspoint.bg/*", "zone_name": "newspoint.bg" }],
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "vars": { "ENABLED": "0", "PUBLIC_ORIGIN": "https://newspoint.bg" }
}
